<?xml version="1.0" encoding="utf-8"?>
<!-- Edit this file to customise the home screen, then run ./build_and_install.sh -->
<resources>
    <!-- Dock apps, left to right. Package names; missing or disabled apps are skipped. -->
    <string-array name="dock_packages">
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>in.startv.hotstar</item>
        <item>com.google.android.youtube.tv</item>
        <item>com.nk.live_tv</item>
    </string-array>

    <!-- Apps per row, in the dock and in the grid (3 to 6). -->
    <integer name="columns">5</integer>

    <!-- Apps never shown in the grid. -->
    <string-array name="hidden_packages">
        <item>com.google.android.tvlauncher</item>
        <item>com.android.tv.settings</item>
        <item>com.mitv.dream</item>
        <item>com.android.gallery3d</item>
    </string-array>

    <!-- Name in the greeting ("Good evening, CupiDroiD"). Leave empty for no name. -->
    <string name="greeting_name">CupiDroiD</string>

    <!-- Follower counters under the top-right buttons, refreshed every 30 minutes while the home
         screen is open. Leave any of them empty to hide that counter. -->
    <!-- YouTube channel handle -->
    <string name="youtube_channel"></string>
    <!-- Instagram username (instagram.com/<this>) -->
    <string name="instagram_user"></string>
    <!-- Facebook profile or page name (facebook.com/<this>) -->
    <string name="facebook_page"></string>

    <!-- Wallpaper sources: bundled 1280x720 jpgs (res/drawable-nodpi/wallpaper_1.jpg, ...),
         photos pushed from the phone page, and images in the folders listed further down.
         With more than one photo they fade from one to the next every wallpaper_seconds.
         use_wallpaper false = pitch black. -->
    <bool name="use_wallpaper">true</bool>
    <integer name="wallpaper_seconds">30</integer>

    <!-- Keep the bundled wallpapers in the rotation. false removes them (photos pushed from the
         phone stay). Only affects installations where the bundled photos were copied in the first
         place (first run with this flag true). -->
    <bool name="use_bundled_wallpapers">true</bool>

    <!-- Extra folders with your own images, scanned alphabetically and appended after the
         bundled/tracked photos. /sdcard/Wallpapers works over USB (MTP: Internal storage /
         Wallpapers) and adb push. Supported types: jpg, jpeg, png, webp. -->
    <string-array name="wallpaper_dirs">
        <item>/sdcard/Wallpapers</item>
    </string-array>

    <!-- Top-right "Wallpaper" button that opens a remote-friendly picker (D-pad: choose photo,
         OK shows it now, BACK closes). false hides the button. -->
    <bool name="show_wallpaper_pill">true</bool>

    <!-- The big sharp region: the wallpaper photo is fully visible between the blurred top band
         (down the buttons) and the blurred bottom band (up to the dock row). The two numbers
         mark where the sharp region starts/ends, as per-mille of the screen height; the blur
         ramps from the screen edges down/up over blur_fade /1000 of the height. -->
    <integer name="wallpaper_clear_top">300</integer>
    <integer name="wallpaper_clear_bottom">640</integer>
    <integer name="wallpaper_blur_fade">140</integer>

    <!-- Progressive blur: an extra-heavy blur layer hugs the very top and bottom edges so the
         ramp strengthens towards the edges instead of being one flat fade. -->
    <bool name="wallpaper_progressive">true</bool>

    <!-- Frosted spots: feathered rounded panels of blur behind the clock/greeting block and the
         pill row, so text stays readable even when the sharp region passes under it. The
         feather is the softness of the panel edge, in dp. 0 disables the spots. -->
    <integer name="wallpaper_spot_feather">44</integer>

    <!-- Darkness over the wallpaper photo, top to bottom: dark enough for the buttons, light in
         the clear region, dark over the dock row. Any number of "#RRGGBB..." colors works; a
         missing or unparsable array falls back to the defaults below. -->
    <string-array name="wallpaper_scrim" translatable="false">
        <item>#8C000000</item>
        <item>#26000000</item>
        <item>#73000000</item>
        <item>#E6000000</item>
    </string-array>
</resources>
